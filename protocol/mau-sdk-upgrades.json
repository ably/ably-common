        {
          "package": "@ably/spaces",
          "ecosystem": "npm",
          "minVersion": "0.6.0"
        },
        {
          "package": "@ably/pubsub-device",
          "ecosystem": "npm",
          "minVersion": "3.0.0",
          "side": "device"
        },
        {
          "package": "@ably/pubsub-server",
          "ecosystem": "npm",
          "minVersion": "3.0.0",
          "side": "server"
        }
