      "replacements": [
        {
          "package": "ably-chat-swift",
          "ecosystem": "swift",
          "minVersion": "2.0.0"
        },
        {
          "package": "ably-pubsub-cocoa",
          "component": "AblyPubSubDevice",
          "ecosystem": "swift",
          "minVersion": "2.0.0",
          "side": "device"
