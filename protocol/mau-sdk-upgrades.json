{
  "$schema": "../json-schemas/src/mau-sdk-upgrades.json",
  "errorCode": 40168,
  "preamble": "This version of the Ably SDK is not compatible with your account, which uses MAU pricing.",
  "fallback": "Upgrade to the latest version that is listed as compatible with MAU pricing. See https://ably.com/docs/sdks",
  "upgrades": [
    {
      "identifiers": ["ably-cli"],
      "instruction": "Upgrade @ably/cli to 2.0.0+.",
      "replacements": [
        {
          "package": "@ably/cli",
          "ecosystem": "npm",
          "minVersion": "2.0.0"
        }
      ]
    },
    {
      "identifiers": ["laravel-echo"],
      "instruction": "Upgrade @ably/laravel-echo to 1.1.0+, which installs @ably/pubsub-device itself, instead of the ably npm package.",
      "replacements": [
        {
          "package": "@ably/laravel-echo",
          "ecosystem": "npm",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "identifiers": ["laravel-broadcaster"],
      "instruction": "Upgrade ably/laravel-broadcaster to 1.1.0+, which uses ably/pubsub-server instead of ably/ably-php.",
      "replacements": [
        {
          "package": "ably/laravel-broadcaster",
          "ecosystem": "packagist",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "identifiers": ["laravel"],
      "instruction": "Use ably/laravel-broadcaster 1.1.0+, or ably/pubsub-server 2.0.0+ directly, instead of ably/ably-php-laravel.",
      "replacements": [
        {
          "package": "ably/laravel-broadcaster",
          "ecosystem": "packagist",
          "minVersion": "1.1.0"
        },
        {
          "package": "ably/pubsub-server",
          "ecosystem": "packagist",
          "minVersion": "2.0.0",
          "side": "server"
        }
      ]
    },
    {
      "identifiers": ["kafka-connect-ably"],
      "instruction": "Upgrade kafka-connect-ably to 4.2.0+.",
      "replacements": [
        {
          "package": "kafka-connect-ably",
          "minVersion": "4.2.0"
        }
      ]
    },
    {
      "identifiers": ["chat-react", "chat-js"],
      "instruction": "Upgrade @ably/chat to 2.0.0+ and use it with @ably/pubsub-device 3.0.0+ on end-user devices or @ably/pubsub-server 3.0.0+ on servers, instead of the ably npm package.",
      "replacements": [
        {
          "package": "@ably/chat",
          "ecosystem": "npm",
          "minVersion": "2.0.0"
        },
        {
          "package": "@ably/pubsub-device",
          "ecosystem": "npm",
          "minVersion": "3.0.0",
          "side": "device"
        },
        {
          "package": "@ably/pubsub-server",
          "ecosystem": "npm",
          "minVersion": "3.0.0",
          "side": "server"
        }
      ]
    },
    {
      "identifiers": ["spaces"],
